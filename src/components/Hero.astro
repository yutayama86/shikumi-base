---
import { services } from '../data/taxonomy';
---

<section class="hero" id="top">
  <div class="wrap hero__inner">
    <div class="hero__message reveal">
      <p class="hero__label">中小企業・地域事業者のWeb・SNS支援</p>
      <h1 class="hero__title">
        <span>ホームページとSNSを、</span>
        <em>相談につながる形に。</em>
      </h1>
      <p class="hero__lead">
        ホームページの制作・改善、SNSの企画・添削・分析、問い合わせ対応の整理。
        必要な支援を絞り、社内の担当者が続けられる運用まで整えます。
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="/contact/?topic=system" data-cta="hero-consult" data-cta-topic="system">
          支援内容を相談する<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost" href="#service" data-cta="hero-services">頼めることを見る</a>
      </div>
      <ul class="hero__facts" aria-label="支援の進め方">
        <li><strong>必要なところから</strong><span>一つの課題に絞って着手</span></li>
        <li><strong>担当者と一緒に</strong><span>企画・手順・改善を共有</span></li>
        <li><strong>範囲を決めて</strong><span>内容・費用を確認して開始</span></li>
      </ul>
      <p class="hero__note">東京・茨城を拠点に、事業者のWeb・SNSと日々の運用を支援しています。</p>
    </div>
    <aside class="hero__work reveal" data-delay="1" aria-label="シクミベースに頼める仕事">
      <p class="hero__work-kicker">シクミベースに頼めること</p>
      <h2>つくる。整える。<br />続けられる形にする。</h2>
      <ol class="work-list">
        {services.map((service, index) => (
          <li>
            <a href={`/service/${service.id}/`} data-cta="hero-service" data-cta-topic={service.id}>
              <span class="work-list__no" aria-hidden="true">0{index + 1}</span>
              <span class="work-list__content">
                <strong>{service.name}</strong>
                <span>{service.deliverables[0]}</span>
              </span>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="hero__work-foot">企画表・サイト・管理表・手順書など、<br />実際に使えるものを一緒に整えます。</p>
    </aside>
  </div>
</section>

<style>
  .hero { position: relative; background: var(--paper); border-bottom: 1px solid var(--line); }
  .hero__inner { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, .85fr); gap: clamp(32px, 4vw, 64px); align-items: center; padding-block: clamp(48px, 6.5vw, 88px); }
  .hero__label { font-size: var(--fs-body-sm); font-weight: 700; color: var(--blue-ink); }
  .hero__title { margin-top: 22px; font-size: clamp(2rem, 1.25rem + 2.6vw, 3.4rem); line-height: 1.4; color: var(--navy); }
  .hero__title > span, .hero__title em { display: block; }
  .hero__title em { font-style: normal; color: var(--blue); }
  .hero__lead { margin-top: 24px; max-width: 36em; font-size: var(--fs-lead); color: var(--text-mute); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .hero__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--line); }
  .hero__facts li { display: grid; gap: 4px; }
  .hero__facts strong { font-size: var(--fs-body-sm); color: var(--navy); }
  .hero__facts span, .hero__note { font-size: .75rem; color: var(--text-mute); }
  .hero__note { margin-top: 18px; }
  .hero__work { padding: clamp(24px, 3vw, 36px); border-top: 4px solid var(--blue); background: var(--navy); color: var(--text-on-dark); }
  .hero__work-kicker { font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .hero__work h2 { margin-top: 10px; font-size: var(--fs-h3); }
  .work-list { margin-top: 22px; border-top: 1px solid var(--line-on-dark); }
  .work-list a { display: grid; grid-template-columns: 22px minmax(0, 1fr) 14px; gap: 10px; align-items: center; padding-block: 18px; border-bottom: 1px solid var(--line-on-dark); }
  .work-list a:hover .work-list__content strong { text-decoration: underline; text-underline-offset: 4px; }
  .work-list a:focus-visible { outline-color: var(--text-on-dark); }
  .work-list__no { font-size: .75rem; color: var(--text-on-dark-mute); }
  .work-list__content { display: grid; gap: 5px; }
  .work-list__content strong { font-size: var(--fs-body-sm); }
  .work-list__content > span { font-size: .75rem; color: var(--text-on-dark-mute); }
  .hero__work-foot { margin-top: 20px; font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  @media (max-width: 960px) { .hero__inner { grid-template-columns: 1fr; } .hero__work { max-width: 680px; } }
  @media (max-width: 560px) { .hero__actions .btn { width: 100%; } .hero__facts { grid-template-columns: 1fr; gap: 12px; } .hero__facts li { display: flex; flex-wrap: wrap; gap: 4px 12px; } }
</style>
