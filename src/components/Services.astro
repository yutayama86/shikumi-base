---
import { services } from '../data/taxonomy';
---

<section class="services section" id="service">
  <div class="wrap">
    <div class="services__head reveal">
      <p class="kicker">サービス<span class="kicker__en">SERVICE</span></p>
      <h2 class="section-title">具体的に、何を頼める？</h2>
      <p class="section-lead measure">ホームページ、SNS、問い合わせ対応。今困っているところから、必要な支援を選べます。</p>
    </div>
    <ol class="service-grid">
      {services.map((service, index) => (
        <li class="service reveal" data-delay={String(index)}>
          <span class="service__no">0{index + 1}</span>
          <h3 class="service__title">{service.name}</h3>
          <p class="service__engagement">{service.engagement}</p>
          <p class="service__summary">{service.summary}</p>
          <div class="service__who"><strong>こんな方に</strong><p>{service.forWho}</p></div>
          <p class="service__label">ご用意するもの</p>
          <ul class="service__list">{service.deliverables.slice(0, 3).map((item) => <li>{item}</li>)}</ul>
          <a class="service__more" href={`/service/${service.id}/`} data-cta="home-service-detail" data-cta-topic={service.id}>支援内容・進め方を見る <span aria-hidden="true">→</span></a>
        </li>
      ))}
    </ol>
    <div class="scope reveal">
      <div>
        <h3>単発の制作から、継続的な改善まで。</h3>
        <p>ホームページは制作・改善する範囲を、SNSは毎月の企画・添削・振り返りの範囲を決めて進めます。必要な業務だけを切り出してご相談いただけます。</p>
      </div>
      <div>
        <h3>費用は、内容に合わせてお見積もり。</h3>
        <p>作業内容、納品物、お客様にご対応いただくこと、期間、料金を事前に確認します。撮影や追加制作、ツールの利用料が必要な場合も、先にご案内します。</p>
      </div>
    </div>
    <p class="services__action reveal"><a class="btn btn--primary" href="/contact/?topic=system" data-cta="home-system-consult" data-cta-topic="system">自社に合う支援を相談する<span class="btn__arrow" aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .services { background: var(--sky-soft); }
  .kicker__en { color: var(--text-mute); }
  .service-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: clamp(32px, 4vw, 48px); }
  .service { display: flex; flex-direction: column; padding: clamp(22px, 2.5vw, 32px); background: var(--paper); border: 1px solid var(--line); border-top: 3px solid var(--blue); border-radius: var(--radius); }
  .service__no { font-size: .75rem; font-weight: 700; color: var(--blue); }
  .service__title { margin-top: 12px; font-size: var(--fs-h3); color: var(--navy); }
  .service__engagement { margin-top: 12px; font-size: .75rem; font-weight: 700; color: var(--blue-ink); }
  .service__summary { margin-top: 14px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .service__who { margin-top: 22px; padding-block: 14px; border-block: 1px solid var(--line); }
  .service__who strong, .service__label { font-size: .75rem; font-weight: 700; color: var(--blue-ink); }
  .service__who p { margin-top: 5px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .service__label { margin-top: 20px; }
  .service__list { display: grid; gap: 10px; margin-block: 10px 26px; }
  .service__list li { position: relative; padding-left: 18px; font-size: var(--fs-body-sm); }
  .service__list li::before { content: '✓'; position: absolute; left: 0; color: var(--blue); }
  .service__more { margin-top: auto; padding-top: 18px; border-top: 1px solid var(--line); font-size: var(--fs-body-sm); font-weight: 700; color: var(--blue-ink); }
  .service__more:hover { text-decoration: underline; text-underline-offset: 4px; }
  .scope { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; margin-top: 32px; padding: clamp(24px, 3vw, 36px); background: var(--navy); color: var(--text-on-dark); }
  .scope h3 { font-size: var(--fs-h3); }
  .scope p { margin-top: 12px; font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .services__action { margin-top: 28px; }
  @media (max-width: 1000px) { .service-grid { grid-template-columns: 1fr; } }
  @media (max-width: 680px) { .scope { grid-template-columns: 1fr; gap: 24px; } .services__action .btn { width: 100%; } }
</style>
