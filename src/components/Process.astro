---
const steps = [
  {
    no: '01',
    phase: '整理',
    title: '困っていることを確認',
    body: 'サイトやSNS、今の対応手順を見ながら、何を改善したいかと社内で対応できることを確認します。',
  },
  {
    no: '02',
    phase: '設計',
    title: '内容・費用・役割を決定',
    body: '制作するページ、企画・添削の範囲、納品物、期間、料金をお見積もり。双方の担当を決めてから開始します。',
  },
  {
    no: '03',
    phase: '実装',
    title: '制作・運用を進める',
    body: 'サイト、投稿企画、管理表などをつくり、お客様の確認を受けながら公開・実際の運用へ進めます。',
  },
  {
    no: '04',
    phase: '改善',
    title: '使い方を共有し、改善',
    body: '更新・投稿・対応の手順を共有。ご契約の範囲に合わせて、問い合わせや運用状況を振り返ります。',
  },
];
---

<section class="process section--tight section on-dark" id="process">
  <div class="wrap">
    <div class="process__head reveal">
      <p class="kicker">ご相談からの流れ<span class="kicker__en">PROCESS</span></p>
      <h2 class="section-title">
        必要な仕事を決めてから、進めます。
      </h2>
      <p class="section-lead measure">
        ご相談内容をもとに、やることと役割を具体化。納品して終わりではなく、担当者が使える状態まで整えます。
      </p>
    </div>

    <ol class="steps">
      {steps.map((step, index) => (
        <li class="step reveal" data-delay={String(index)}>
          <div class="step__marker" aria-hidden="true"><span class="step__dot"></span></div>
          <span class="step__days">{step.phase}</span>
          <span class="step__no">STEP {step.no}</span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__body">{step.body}</p>
        </li>
      ))}
    </ol>

    <p class="process__note reveal">
      重要な顧客対応、契約、価格判断は、お客様の確認を前提に進めます。追加作業や有料ツールが必要な場合も、実施前にご案内します。
    </p>
  </div>
</section>

<style>
  .process { background: var(--navy); color: var(--text-on-dark); }
  .kicker__en { margin-left: 8px; opacity: 0.7; }
  .process__head { max-width: 52em; }
  .steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 2.6vw, 40px); margin-top: clamp(40px, 4.6vw, 64px); }
  .step { position: relative; }
  .step__marker { position: relative; height: 11px; margin-bottom: 20px; }
  .step__marker::before { content: ''; position: absolute; top: 5px; left: 0; right: calc(-1 * clamp(20px, 2.6vw, 40px)); height: 1px; background: var(--line-on-dark); }
  .step:last-child .step__marker::before { right: 0; background: linear-gradient(to right, var(--line-on-dark), transparent); }
  .step__dot { position: absolute; top: 0; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--navy); border: 2px solid var(--blue); }
  .step:last-child .step__dot { border-color: var(--gold); background: var(--gold); }
  .step__days { display: block; font-size: 0.75rem; font-weight: 700; color: var(--gold); }
  .step__no { display: block; margin-top: 2px; font-size: 0.625rem; font-weight: 700; letter-spacing: var(--ls-label); color: var(--text-on-dark-mute); }
  .step__title { margin-top: 10px; font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem); }
  .step__body { margin-top: 10px; font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .process__note { margin-top: clamp(32px, 4vw, 48px); padding-top: 18px; border-top: 1px solid var(--line-on-dark); font-size: 0.75rem; color: var(--text-on-dark-mute); }
  @media (max-width: 900px) and (min-width: 641px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 34px; } .step:nth-child(2n) .step__marker::before { right: 0; } }
  @media (max-width: 640px) {
    .steps { display: block; margin-top: 36px; }
    .step { padding-left: 30px; padding-bottom: 28px; }
    .step:last-child { padding-bottom: 0; }
    .step__marker { position: absolute; inset-block: 0; left: 0; width: 11px; height: auto; margin: 0; }
    .step__marker::before { top: 16px; bottom: -6px; left: 5px; right: auto; width: 1px; height: auto; background: var(--line-on-dark); }
    .step:last-child .step__marker::before { display: none; }
    .step__dot { top: 5px; }
  }
</style>
