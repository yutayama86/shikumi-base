---
import { services } from '../data/taxonomy';
---

<section class="examples section" id="support-examples">
  <div class="wrap">
    <div class="examples__head reveal">
      <p class="kicker">支援イメージ<span class="kicker__en">EXAMPLES</span></p>
      <h2 class="section-title">ご相談から、こんな形に整えます。</h2>
      <p class="section-lead measure">困りごとに対して、どんな仕事を引き受け、何をお渡しするのか。具体的な相談例でご紹介します。</p>
      <p class="examples__note">以下は提供内容を説明するための相談例です。実際の内容は、状況とご依頼の範囲に合わせて決めます。</p>
    </div>
    <ol class="examples__list">
      {services.map((service, index) => (
        <li class="example reveal">
          <div class="example__heading">
            <span class="example__no" aria-hidden="true">0{index + 1}</span>
            <div><p class="example__service">{service.name}</p><h3>{service.example.title}</h3></div>
          </div>
          <dl class="example__body">
            <div><dt>ご相談の状況</dt><dd>{service.example.problem}</dd></div>
            <div><dt>シクミベースがすること</dt><dd>{service.example.support}</dd></div>
          </dl>
          <div class="example__handover"><strong>お渡しするもの</strong><p>{service.example.handover}</p></div>
          <p class="example__check"><strong>確認すること</strong>{service.example.check}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .examples { background: var(--paper); }
  .kicker__en { color: var(--text-mute); }
  .examples__note { margin-top: 16px; font-size: .75rem; color: var(--text-mute); }
  .examples__list { display: grid; gap: 28px; margin-top: clamp(32px, 4vw, 48px); }
  .example { border: 1px solid var(--line); padding: clamp(24px, 3vw, 36px); border-radius: var(--radius); }
  .example__heading { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 16px; align-items: start; }
  .example__no { display: grid; place-items: center; min-height: 40px; background: var(--sky); color: var(--blue-ink); font-size: .75rem; font-weight: 700; border-radius: var(--radius); }
  .example__service { color: var(--blue-ink); font-size: .75rem; font-weight: 700; }
  .example h3 { margin-top: 6px; font-size: var(--fs-h3); color: var(--navy); }
  .example__body { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 32px; margin-top: 24px; }
  .example dt, .example__handover strong, .example__check strong { font-size: .75rem; font-weight: 700; color: var(--blue-ink); }
  .example dd { margin-top: 8px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .example__handover { margin-top: 24px; padding: 16px 20px; background: var(--sky-soft); }
  .example__handover p { margin-top: 4px; font-size: var(--fs-body-sm); color: var(--navy); }
  .example__check { display: grid; gap: 4px; margin-top: 16px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  @media (max-width: 680px) { .example__body { grid-template-columns: 1fr; gap: 20px; } .example__heading { grid-template-columns: 32px minmax(0, 1fr); gap: 12px; } .example__no { min-height: 32px; } }
</style>
