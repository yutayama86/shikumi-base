---
const topics = [
  'ホームページを新しく作りたい・改善したい',
  'SNSの企画や投稿内容を相談したい',
  '問い合わせの管理や返信手順を整えたい',
  'どこから手を付ければよいか相談したい',
];
---

<section class="contact section on-dark" id="contact">
  <div class="wrap contact__inner">
    <div class="contact__body reveal">
      <p class="kicker">相談<span class="kicker__en">CONTACT</span></p>
      <h2 class="contact__title">
        「これ、頼める？」から<br />ご相談ください。
      </h2>
      <p class="contact__lead measure">
        今のサイトやSNSのURL、困っていること、ご希望の進め方をお知らせください。
        必要な仕事を整理し、対応できる内容とお見積もりをご案内します。
      </p>

      <div class="contact__actions">
        <a class="btn btn--on-dark" href="/contact/?topic=system" data-cta="home-system-contact">
          支援内容を相談する<span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="contact__note">
        法人化前の個人運営ブランドのため、対応可能な件数には限りがあります。内容を確認したうえで、対応可否をご案内します。
      </p>
    </div>

    <aside class="contact__deliverables reveal" data-delay="1">
      <h3>こんな相談から始められます</h3>
      <ul>
        {topics.map((item) => <li>{item}</li>)}
      </ul>
      <p>
        依頼するサービスが決まっていなくても大丈夫です。現在の状況から、必要な支援を一緒に整理します。
      </p>
      <a class="contact__direct" href="/service/">サービスを確認する →</a>
    </aside>
  </div>
</section>

<style>
  .contact { background: var(--navy); color: var(--text-on-dark); }
  .kicker__en { margin-left: 8px; opacity: 0.7; }
  .contact__inner { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(300px, 0.88fr); gap: clamp(36px, 5vw, 80px); align-items: start; }
  .contact__title { font-size: var(--fs-h2); }
  .contact__lead { margin-top: clamp(18px, 2.2vw, 26px); color: var(--text-on-dark-mute); }
  .contact__actions { margin-top: clamp(26px, 3vw, 36px); }
  .contact__note { margin-top: 18px; font-size: .75rem; color: var(--text-on-dark-mute); }
  .contact__deliverables { padding: clamp(24px, 3vw, 34px); border-top: 3px solid var(--gold); background: rgba(255,255,255,.07); }
  .contact__deliverables h3 { font-size: 1rem; }
  .contact__deliverables ul { display: grid; gap: 12px; margin-top: 20px; }
  .contact__deliverables li { position: relative; padding-left: 24px; font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .contact__deliverables li::before { content: '✓'; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
  .contact__deliverables p { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line-on-dark); font-size: .75rem; color: var(--text-on-dark-mute); }
  .contact__direct { display: inline-block; margin-top: 18px; font-size: var(--fs-body-sm); font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 860px) { .contact__inner { grid-template-columns: 1fr; } .contact__actions .btn { width: 100%; } }
</style>
