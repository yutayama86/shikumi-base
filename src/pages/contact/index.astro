---
import PageLayout from '../../layouts/PageLayout.astro';
import { services } from '../../data/taxonomy';
import { contact } from '../../site.config';

const topics = [
  { value: 'system', label: '自社に合う支援を相談したい' },
  ...services.map((s) => ({ value: s.id, label: s.name })),
  { value: 'local', label: '茨城・地域のプロジェクトを相談したい' },
  { value: 'other', label: 'その他' },
];

const turnstileSiteKey = '0x4AAAAAAEmB3I5NAyMoIF6c';
---

<PageLayout
  title="お問い合わせ｜シクミベース"
  description="ホームページ制作・改善、SNSの企画・添削・分析、問い合わせ・業務の整理についての相談窓口です。現在の状況を確認し、支援内容、役割分担、期間、費用をご案内します。"
  kicker="CONTACT"
  heading="今困っていることを、お聞かせください。"
  lead="サイトやSNSのURL、改善したいこと、ご希望の時期をお知らせください。内容を確認して、対応できる支援と進め方をご案内します。"
  crumbs={[{ label: 'ホーム', href: '/' }, { label: 'お問い合わせ' }]}
>
  <div class="wrap body">
    <form class="form" id="contact-form" method="post" action="/api/contact" novalidate data-fallback-email={contact.email ?? ''}>
      <div class="field">
        <label for="topic">ご相談の種類<span class="req">必須</span></label>
        <select id="topic" name="topic" required>
          <option value="">選択してください</option>
          {topics.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="name">お名前<span class="req">必須</span></label>
        <input type="text" id="name" name="name" required maxlength="100" autocomplete="name" />
      </div>

      <div class="field">
        <label for="company">会社名・屋号<span class="req">必須</span></label>
        <input type="text" id="company" name="company" required maxlength="200" autocomplete="organization" />
      </div>

      <div class="field">
        <label for="email">メールアドレス<span class="req">必須</span></label>
        <input type="email" id="email" name="email" required maxlength="254" autocomplete="email" />
      </div>

      <div class="field">
        <label for="companyUrl">WebサイトURL<span class="opt">任意</span></label>
        <input type="url" id="companyUrl" name="companyUrl" maxlength="500" inputmode="url" autocomplete="url" />
      </div>

      <div class="field">
        <label for="message">ご相談内容<span class="req">必須</span></label>
        <textarea
          id="message"
          name="message"
          rows="9"
          required
          maxlength="5000"
          placeholder="例：ホームページのサービス説明を分かりやすくしたい／SNSの投稿企画や添削を相談したい／問い合わせの対応状況を管理表にまとめたい、など。ご希望の時期や社内の担当者の有無もお知らせください。"
        ></textarea>
      </div>

      <div class="field field--check">
        <label class="check">
          <input type="checkbox" id="agree" name="agree" required />
          <span><a href="/privacy/" target="_blank" rel="noopener">プライバシーポリシー</a>に同意します<span class="req">必須</span></span>
        </label>
      </div>

      <div class="honeypot" aria-hidden="true">
        <label for="website">サイトURL（入力しないでください）</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="security-check">
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="contact" data-theme="light" data-language="ja"></div>
        <p>迷惑送信を防ぐため、Cloudflareによる安全確認を行います。</p>
      </div>

      <div class="form__error" id="form-error" role="alert" hidden></div>

      <button class="btn btn--primary form__submit" type="submit">
        内容を送信する<span class="btn__arrow" aria-hidden="true">→</span>
      </button>
      <p class="form__note">通常2営業日以内を目安にご返信します。</p>
    </form>

    <aside class="side">
      <section class="side__block">
        <h2 class="side__title">主なご相談</h2>
        <ul class="side__list">
          <li>ホームページの制作・リニューアル・更新</li>
          <li>SNSの投稿企画・添削・分析と改善</li>
          <li>予約や問い合わせへの導線づくり</li>
          <li>問い合わせ管理表・返信例・手順書の整備</li>
          <li>自社に合う支援内容・費用の相談</li>
        </ul>
      </section>

      <section class="side__block">
        <h2 class="side__title">進め方</h2>
        <ol class="side__steps">
          <li><strong>01 内容確認</strong><span>サイト・SNS・現在の状況を確認</span></li>
          <li><strong>02 ご案内</strong><span>支援範囲・納品物・期間・費用をご提案</span></li>
          <li><strong>03 開始</strong><span>内容に合意してから制作・運用へ</span></li>
          <li><strong>04 共有・改善</strong><span>使い方や運用結果を確認</span></li>
        </ol>
      </section>

      {contact.email && (
        <section class="side__block">
          <h2 class="side__title">メールでのご相談</h2>
          <p class="side__text"><a href={`mailto:${contact.email}`} data-cta="contact-email" data-cta-label="メールでのご相談">{contact.email}</a></p>
        </section>
      )}

      <section class="side__block side__block--note">
        <p>シクミベースは、山野辺 雄太が個人で運営する事業ブランドです（法人化前）。</p>
      </section>
    </aside>
  </div>

  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline>
    (() => {
      const form = document.getElementById('contact-form');
      const errorBox = document.getElementById('form-error');
      if (!(form instanceof HTMLFormElement) || !(errorBox instanceof HTMLElement)) return;

      const submit = form.querySelector('button[type="submit"]');
      const topicField = form.querySelector('#topic');
      const FORM_ID = 'contact';
      const STARTED_KEY = 'shikumi:contact_form_started';

      // 計測は送信処理から切り離す。GA4が読み込めない・例外を投げても問い合わせは止めない。
      const track = (name, params, options) => {
        try {
          return window.shikumiAnalytics ? window.shikumiAnalytics.track(name, params, options) : false;
        } catch {
          return false;
        }
      };
      const session = {
        get: (key) => { try { return sessionStorage.getItem(key); } catch { return null; } },
        set: (key, value) => { try { sessionStorage.setItem(key, value); } catch { /* 保存できない環境では同一ページ内の重複だけ防ぐ */ } },
        remove: (key) => { try { sessionStorage.removeItem(key); } catch { /* noop */ } },
      };
      // 送るのは選択肢の固定値だけ。入力欄の値は計測に使わない。
      const topicValue = () => (topicField instanceof HTMLSelectElement ? topicField.value : '');

      // URLの ?topic= を初期選択に反映し、どのCTAから来たかを引き継ぐ
      const topicParam = new URLSearchParams(location.search).get('topic');
      if (topicParam && topicField instanceof HTMLSelectElement) {
        if ([...topicField.options].some((o) => o.value === topicParam)) topicField.value = topicParam;
      }

      // 最初の操作で1回だけ送る。再読み込みしても、送信が完了するまでは同じ入力の続きとして数えない。
      let started = session.get(STARTED_KEY) === '1';
      const markStarted = (event) => {
        // Turnstileやハニーポットなど、訪問者が操作しない欄の変化は数えない
        const field = event.target;
        const isUserField =
          (field instanceof HTMLInputElement && field.type !== 'hidden' && field.name !== 'website') ||
          field instanceof HTMLSelectElement ||
          field instanceof HTMLTextAreaElement;
        if (started || !isUserField) return;
        started = true;
        session.set(STARTED_KEY, '1');
        track('contact_form_start', { form_id: FORM_ID, topic: topicValue() });
      };
      form.addEventListener('input', markStarted);
      form.addEventListener('change', markStarted);

      const showError = (message, fallbackHref) => {
        errorBox.textContent = '';
        const text = document.createElement('p');
        text.textContent = message;
        errorBox.appendChild(text);

        if (fallbackHref) {
          const link = document.createElement('a');
          link.className = 'btn btn--primary form__fallback';
          link.href = fallbackHref;
          link.textContent = 'メールで送る';
          link.dataset.cta = 'contact-fallback';
          errorBox.appendChild(link);
        }

        errorBox.hidden = false;
        errorBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
      };

      /** 入力内容を本文に載せた mailto: を組み立てる。 */
      const mailtoFallback = (data) => {
        const email = form.dataset.fallbackEmail;
        if (!email) return null;
        const topicLabel =
          topicField instanceof HTMLSelectElement ? topicField.options[topicField.selectedIndex]?.text ?? '' : '';
        const body = [
          `ご相談の種類: ${topicLabel}`,
          `お名前: ${data.get('name') ?? ''}`,
          `会社名・屋号: ${data.get('company') ?? ''}`,
          `メールアドレス: ${data.get('email') ?? ''}`,
          data.get('companyUrl') ? `WebサイトURL: ${data.get('companyUrl')}` : null,
          '',
          '--- ご相談内容 ---',
          data.get('message') ?? '',
        ].filter((line) => line !== null).join('\n');
        return `mailto:${email}?subject=${encodeURIComponent(`【お問い合わせ】${topicLabel}`)}&body=${encodeURIComponent(body)}`;
      };

      const errorTypeOf = (status) => {
        if (status === 0) return 'network';
        if (status === 400) return 'validation';
        if (status === 403) return 'forbidden';
        if (status === 503) return 'unavailable';
        return 'server';
      };

      /** 送信成功後の処理。計測の成否に関係なく必ずサンクスページへ進む。 */
      const completeSubmission = (topic, isBot) => {
        let redirected = false;
        const redirect = () => {
          if (redirected) return;
          redirected = true;
          window.location.href = '/contact/thanks/';
        };

        session.remove(STARTED_KEY);
        // ハニーポットが埋まった送信はAPIが成功を装って破棄するため、問い合わせとして数えない
        const sent = isBot
          ? false
          : track('generate_lead', { form_id: FORM_ID, topic }, { event_callback: redirect, event_timeout: 1200 });
        setTimeout(redirect, sent ? 1300 : 0);
      };

      let submitting = false;
      let completed = false;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submitting || completed) return;
        errorBox.hidden = true;
        if (!form.checkValidity()) {
          form.reportValidity();
          return;
        }

        submitting = true;
        if (submit instanceof HTMLButtonElement) submit.disabled = true;
        const data = new FormData(form);
        const topic = topicValue();

        let response;
        try {
          response = await fetch(form.action, {
            method: 'POST',
            body: new URLSearchParams(data),
            headers: { Accept: 'application/json' },
          });
        } catch {
          response = null;
        }

        if (response && response.ok) {
          completed = true;
          completeSubmission(topic, Boolean(data.get('website')));
          return;
        }

        const status = response ? response.status : 0;
        const body = response ? await response.json().catch(() => ({})) : {};
        track('form_error', { form_id: FORM_ID, topic, error_type: errorTypeOf(status), status });

        if (status === 400 && body.message) {
          showError(body.message, null);
        } else {
          showError(
            '送信できませんでした。お手数ですが、下のボタンからメールでお送りください。入力いただいた内容はそのまま引き継がれます。',
            mailtoFallback(data)
          );
        }
        // Turnstileのトークンは1回限りのため、再送信できるよう取り直す
        try {
          if (window.turnstile && typeof window.turnstile.reset === 'function') window.turnstile.reset();
        } catch {
          /* noop */
        }
        submitting = false;
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      });

      // サンクスページから戻る操作でキャッシュから復元されたとき、送信済みの状態を持ち越さない。
      // 完了イベントは送信成功の処理内でしか送らないため、復元では再送されない。
      window.addEventListener('pageshow', (event) => {
        if (!event.persisted) return;
        submitting = false;
        completed = false;
        started = session.get(STARTED_KEY) === '1';
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
        try {
          if (window.turnstile && typeof window.turnstile.reset === 'function') window.turnstile.reset();
        } catch {
          /* noop */
        }
      });
    })();
  </script>
</PageLayout>

<style>
  .body { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(260px,.75fr); gap: clamp(32px,5vw,64px); align-items: start; padding-top: clamp(36px,4.5vw,56px); }
  .form { display: grid; gap: 22px; }
  .field { display: grid; gap: 8px; }
  .field label { font-size: var(--fs-body-sm); font-weight: 700; color: var(--navy); }
  .req,.opt { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: var(--radius-pill); font-size: .625rem; font-weight: 700; vertical-align: middle; }
  .req { background: var(--blue); color: #fff; }
  .opt { background: var(--sky); color: var(--blue-ink); }
  input[type='text'],input[type='email'],input[type='url'],select,textarea { width: 100%; padding: 14px 16px; border: 1px solid var(--line-strong); border-radius: var(--radius); background: var(--paper); color: var(--text); font: inherit; font-size: var(--fs-body-sm); line-height: 1.7; }
  input:focus,select:focus,textarea:focus { border-color: var(--blue); outline: 2px solid color-mix(in srgb,var(--blue) 18%,transparent); }
  textarea { resize: vertical; }
  .field--check label { font-weight: 400; }
  .check { display: flex; align-items: flex-start; gap: 10px; }
  .check input { margin-top: .45em; }
  .check a,.side a { color: var(--blue-ink); text-decoration: underline; text-underline-offset: 3px; }
  .honeypot { position: absolute; inline-size: 1px; block-size: 1px; overflow: hidden; clip-path: inset(50%); }
  .security-check { display: grid; gap: 8px; }
  .security-check p,.form__note { font-size: .75rem; color: var(--text-mute); }
  .form__error { padding: 14px 16px; border-left: 3px solid #b42318; background: #fff1f0; color: #7a271a; font-size: var(--fs-body-sm); }
  .form__error :global(p + .form__fallback) { margin-top: 12px; }
  .form__submit { width: fit-content; }
  .form__submit:disabled { opacity: .55; cursor: wait; }
  .side { display: grid; gap: 20px; }
  .side__block { padding: 22px 24px; border: 1px solid var(--line); background: var(--paper); }
  .side__title { font-size: 1rem; color: var(--navy); }
  .side__list { display: grid; gap: 10px; margin-top: 16px; }
  .side__list li { position: relative; padding-left: 18px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .side__list li::before { content: ''; position: absolute; left: 0; top: .75em; width: 8px; height: 2px; background: var(--gold); }
  .side__steps { display: grid; gap: 12px; margin-top: 16px; }
  .side__steps li { display: grid; gap: 2px; }
  .side__steps strong { font-size: .75rem; color: var(--blue-ink); }
  .side__steps span { font-size: var(--fs-body-sm); color: var(--text-mute); }
  .side__text { margin-top: 10px; font-size: var(--fs-body-sm); }
  .side__block--note { border-left: 3px solid var(--gold); }
  .side__block--note p { font-size: .75rem; color: var(--text-mute); }
  @media (max-width: 820px) { .body { grid-template-columns: 1fr; } .form__submit { width: 100%; } }
</style>
