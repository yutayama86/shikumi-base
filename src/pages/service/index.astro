---
import PageLayout from '../../layouts/PageLayout.astro';
import { services } from '../../data/taxonomy';
import { ctaHref } from '../../site.config';
---

<PageLayout
  title="サービス｜ホームページ制作・SNS支援・業務整理｜シクミベース"
  description="ホームページ制作・改善、SNSの企画・添削・分析、問い合わせ・業務の整理。シクミベースに頼める仕事、お渡しするもの、お客様にお願いすること、相談からの進め方をご紹介します。"
  kicker="SERVICE"
  heading="ホームページ・SNS・業務の支援"
  lead="サイトを新しくしたい。SNSの企画や改善を相談したい。問い合わせ対応を整理したい。必要な仕事を決めて、実際に使える形まで整えます。"
  crumbs={[{ label: 'ホーム', href: '/' }, { label: 'サービス' }]}
>
  <div class="wrap body">
    <section class="intro">
      <p class="intro__label">SHIKUMI BASE</p>
      <h2>まず一つの困りごとから、ご相談いただけます。</h2>
      <p>
        作業内容、納品物、期間、料金、お客様にご対応いただくことを事前に確認します。
        ホームページの制作・改善は単発のご依頼から、SNSの企画・改善は継続的な支援まで、状況に合わせてお見積もりします。
      </p>
    </section>

    <ul class="services">
      {services.map((service, index) => (
        <li class="service">
          <div class="service__head">
            <span class="service__no" aria-hidden="true">0{index + 1}</span>
            <h2 class="service__name"><a href={`/service/${service.id}/`}>{service.name}</a></h2>
            <span class="service__en">{service.en}</span>
          </div>

          <div class="service__body">
            <p class="service__summary">{service.summary}</p>
            <p class="service__summary"><strong>{service.engagement}</strong></p>
            <div class="service__cols">
              <div>
                <p class="service__label">こんな課題に</p>
                <ul class="service__list">{service.problems.slice(0, 4).map((p) => <li>{p}</li>)}</ul>
              </div>
              <div>
                <p class="service__label">ご用意するもの</p>
                <ul class="service__list">{service.deliverables.slice(0, 4).map((d) => <li>{d}</li>)}</ul>
              </div>
            </div>

            <div class="service__outcome">
              <span>お客様にお願いすること</span>
              <p>{service.clientRole}</p>
              <p>{service.scopeNote}</p>
            </div>

            <div class="service__outcome">
              <span>目指す状態</span>
              <p>{service.outcome}</p>
            </div>

            <div class="service__actions">
              <a class="btn btn--ghost" href={`/service/${service.id}/`}>詳しく見る</a>
              <a class="btn btn--primary" href={ctaHref(service.id)} data-cta="service-index" data-cta-topic={service.id}>
                {service.ctaLabel}<span class="btn__arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>

    <section class="proof" aria-labelledby="proof-title">
      <p class="proof__label">PUBLIC CASE STUDY</p>
      <h2 id="proof-title">考え方だけでなく、自分たちの運営でも検証しています。</h2>
      <p>
        シクミベースでは、茨城の情報を扱う「イバトコ」の運営を、仕組み化の公開ケーススタディとして扱っています。
        人が判断する仕事と仕組みに任せる仕事を分け、品質基準・更新フロー・改善履歴を運営に組み込む過程を公開しています。
        未確認の成果数値で実績を大きく見せるのではなく、何をどう設計しているかを確認できる形にしています。
      </p>
      <a class="btn btn--ghost" href="/case/ibatoco/" data-cta="service-case-ibatoco">イバトコのケーススタディを見る<span class="btn__arrow" aria-hidden="true">→</span></a>
    </section>

    <section class="method">
      <p class="method__label">進め方</p>
      <h2>内容・費用・役割を決めてから進めます。</h2>
      <ol>
        <li><strong>相談</strong><span>サイト・SNS・対応手順を確認</span></li>
        <li><strong>見積もり</strong><span>作業・納品物・期間・費用を決定</span></li>
        <li><strong>制作・運用</strong><span>お客様の確認を受けながら実施</span></li>
        <li><strong>共有・改善</strong><span>使い方と結果を確認</span></li>
      </ol>
      <a class="btn btn--primary" href={ctaHref('system')} data-cta="service-system-consult">自社に合う支援を相談する<span class="btn__arrow" aria-hidden="true">→</span></a>
    </section>

    <section class="note">
      <h2 class="note__title">運営体制について</h2>
      <p>
        シクミベースは<a href="/about/">山野辺雄太が個人で運営する事業ブランド</a>です。法人化前のため、法人格があるように見える表記は使用していません。
      </p>
    </section>
  </div>
</PageLayout>

<style>
  .body { max-width: calc(1040px + var(--gutter) * 2); padding-top: clamp(36px, 4.5vw, 56px); }
  .intro { max-width: 760px; padding: clamp(26px, 4vw, 44px); border-left: 4px solid var(--gold); background: var(--sky-soft); }
  .intro__label, .method__label, .proof__label { font-size: 0.6875rem; font-weight: 700; letter-spacing: .12em; color: var(--blue-ink); }
  .intro h2, .method h2, .proof h2 { margin-top: 8px; font-size: clamp(1.35rem, 1.15rem + 1vw, 1.9rem); color: var(--navy); }
  .intro p:last-child, .method > p:not(.method__label), .proof > p:not(.proof__label) { margin-top: 12px; color: var(--text-mute); }
  .services { display: grid; gap: clamp(32px, 4vw, 48px); margin-top: clamp(44px, 6vw, 72px); }
  .service { padding-bottom: clamp(32px, 4vw, 48px); border-bottom: 1px solid var(--line); }
  .service:last-child { border-bottom: 0; }
  .service__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px; }
  .service__no { font-size: .75rem; font-weight: 700; letter-spacing: var(--ls-label); color: var(--blue); }
  .service__name { font-size: clamp(1.375rem, 1.2rem + .9vw, 1.75rem); color: var(--navy); }
  .service__en { font-size: .625rem; font-weight: 700; letter-spacing: .14em; color: var(--text-mute); }
  .service__summary { margin-top: 14px; max-width: 44em; color: var(--text-mute); }
  .service__cols { display: grid; grid-template-columns: repeat(auto-fit,minmax(240px,1fr)); gap: 24px; margin-top: 24px; }
  .service__label { font-size: .75rem; font-weight: 700; color: var(--blue-ink); padding-bottom: 8px; border-bottom: 2px solid var(--line-strong); }
  .service__list { margin-top: 12px; display: grid; gap: 8px; }
  .service__list li { position: relative; padding-left: 18px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .service__list li::before { content: ''; position: absolute; left: 0; top: .75em; width: 8px; height: 2px; background: var(--gold); }
  .service__outcome { margin-top: 22px; padding: 16px 18px; background: var(--sky-soft); }
  .service__outcome span { font-size: .6875rem; font-weight: 700; color: var(--blue-ink); }
  .service__outcome p { margin-top: 4px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .service__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
  .proof { margin-top: clamp(54px, 7vw, 84px); padding: clamp(28px, 4vw, 44px); border: 1px solid var(--line); background: var(--paper); }
  .proof > p:not(.proof__label) { max-width: 48em; }
  .proof .btn { margin-top: 24px; }
  .method { margin-top: clamp(54px, 7vw, 84px); padding: clamp(28px, 4vw, 48px); background: var(--navy); color: var(--text-on-dark); }
  .method h2 { color: #fff; }
  .method ol { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1px; margin-top: 28px; background: var(--line-on-dark); }
  .method li { display: grid; gap: 6px; padding: 18px; background: var(--navy); }
  .method li strong { color: var(--gold); }
  .method li span { font-size: var(--fs-body-sm); color: var(--text-on-dark-mute); }
  .method .btn { margin-top: 28px; }
  .note { margin-top: 28px; padding: 22px 24px; border: 1px solid var(--line); background: var(--paper); }
  .note__title { font-size: 1.0625rem; color: var(--navy); }
  .note p { margin-top: 10px; font-size: var(--fs-body-sm); color: var(--text-mute); }
  .note a { color: var(--blue-ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 760px) { .method ol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .service__actions .btn { width: 100%; } .method ol { grid-template-columns: 1fr; } }
</style>
